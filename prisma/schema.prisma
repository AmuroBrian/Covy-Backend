generator client {
  provider   = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id              String    @id @default(uuid())
  email           String?   @unique
  passwordHash    String?
  displayName     String?
  gender          String?
  inviteCode      String    @unique
  avatarUrl       String?
  preferences     Json?     @default("{}")
  provider        AuthProvider @default(EMAIL)
  providerId      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  coupleId        String?
  couple          Couple?   @relation(fields: [coupleId], references: [id])
  
  devices         Device[]
  locations       LocationHistory[]
  messagesSent    Message[]
  tasksAssigned   ChecklistItem[]
  savedPlaces     SavedPlace[]
  reactions       MessageReaction[]
  wishlists       Wishlist[]
  memories        Memory[]
}

enum AuthProvider {
  EMAIL
  GOOGLE
  FACEBOOK
  APPLE
}

model Couple {
  id              String    @id @default(uuid())
  status          CoupleStatus @default(ACTIVE)
  connectedAt     DateTime  @default(now())
  disconnectedAt  DateTime?
  
  users           User[]
  savedPlaces     SavedPlace[]
  statuses        Status[]
  messages        Message[]
  checklists      Checklist[]
  goals           Goal[]
  anniversaries   Anniversary[]
  wishlists       Wishlist[]
  memories        Memory[]
  pet             Pet?
}

enum CoupleStatus {
  ACTIVE
  DISCONNECTED
}

model Device {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  name            String?
  model           String?
  platform        String?
  osVersion       String?
  appVersion      String?
  batteryLevel    Int?      // 0-100
  isCharging      Boolean   @default(false)
  pushToken       String?
  lastActive      DateTime  @default(now())
}

model LocationHistory {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  latitude        Float
  longitude       Float
  accuracy        Float?
  speed           Float?
  heading         Float?
  timestamp       DateTime  @default(now())

  @@index([userId, timestamp(sort: Desc)])
}

model SavedPlace {
  id              String    @id @default(uuid())
  coupleId        String
  couple          Couple    @relation(fields: [coupleId], references: [id])
  userId          String?
  user            User?     @relation(fields: [userId], references: [id])
  label           String    // e.g., "Home", "Office"
  address         String?   // Exact string from search Autocomplete
  icon            String?   // e.g., "home-outline", "briefcase-outline"
  latitude        Float
  longitude       Float
  radius          Float     // Geofence radius
  createdAt       DateTime  @default(now())
}

model Status {
  id              String    @id @default(uuid())
  coupleId        String
  couple          Couple    @relation(fields: [coupleId], references: [id])
  text            String
  emoji           String?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
}

model Message {
  id              String    @id @default(uuid())
  coupleId        String
  couple          Couple    @relation(fields: [coupleId], references: [id])
  senderId        String
  sender          User      @relation(fields: [senderId], references: [id])
  content         String?
  mediaUrl        String?
  type            MessageType @default(TEXT)
  isRead          Boolean   @default(false)
  createdAt       DateTime  @default(now())
  deletedAt       DateTime?

  replyToId       String?
  replyTo         Message?  @relation("MessageReplies", fields: [replyToId], references: [id])
  replies         Message[] @relation("MessageReplies")

  reactions       MessageReaction[]

  @@index([coupleId, createdAt(sort: Desc)])
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId])
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  LOCATION
}

model Checklist {
  id              String    @id @default(uuid())
  coupleId        String
  couple          Couple    @relation(fields: [coupleId], references: [id])
  title           String
  createdAt       DateTime  @default(now())
  items           ChecklistItem[]
}

model ChecklistItem {
  id              String    @id @default(uuid())
  checklistId     String
  checklist       Checklist @relation(fields: [checklistId], references: [id])
  title           String
  isCompleted     Boolean   @default(false)
  assignedToId    String?
  assignee        User?     @relation(fields: [assignedToId], references: [id])
  dueDate         DateTime?
}

model Goal {
  id              String    @id @default(uuid())
  coupleId        String
  couple          Couple    @relation(fields: [coupleId], references: [id])
  title           String
  description     String?
  targetDate      DateTime?
  isCompleted     Boolean   @default(false)
  progress        Float     @default(0)
  targetAmount    Float?
  createdAt       DateTime  @default(now())
}

model Anniversary {
  id              String    @id @default(uuid())
  coupleId        String
  couple          Couple    @relation(fields: [coupleId], references: [id])
  title           String
  date            DateTime
  imageUrl        String?
  createdAt       DateTime  @default(now())
}

model Wishlist {
  id              String    @id @default(uuid())
  coupleId        String
  couple          Couple    @relation(fields: [coupleId], references: [id])
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  title           String
  linkUrl         String?
  imageUrl        String?
  price           Float?
  isSecret        Boolean   @default(false)
  createdAt       DateTime  @default(now())
}

model Memory {
  id              String    @id @default(uuid())
  coupleId        String
  couple          Couple    @relation(fields: [coupleId], references: [id])
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  imageUrl        String
  caption         String?
  date            DateTime  @default(now())
  createdAt       DateTime  @default(now())
}

model Pet {
  id              String    @id @default(uuid())
  coupleId        String    @unique
  couple          Couple    @relation(fields: [coupleId], references: [id])
  name            String    @default("Pou")
  hunger          Int       @default(100) // 0 is starving, 100 is full
  happiness       Int       @default(100) // 0 is sad, 100 is happy
  sleepiness      Int       @default(0)   // 0 is awake, 100 is sleepy
  state           String    @default("IDLE") // IDLE, EATING, SLEEPING, SCARED
  lastFedAt       DateTime  @default(now())
  lastPettedAt    DateTime  @default(now())
  lastSleptAt     DateTime  @default(now())
  createdAt       DateTime  @default(now())
}
